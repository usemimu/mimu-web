# Google Analytics 4 measurement id (G-XXXXXXXXXX).
# Production already defaults to the live property (G-XVRHCKX08B) in
# src/analytics.js, so you only need this to OVERRIDE it — e.g. to point a
# staging deploy at a separate GA property, or to enable GA in local dev
# (by default GA does not load during `npm run dev`).
VITE_GA_ID=

# Public API base for the offer portal pages (claim/confirm/unsubscribe).
VITE_API_URL=https://api.usemimu.com/v1
